# Claude Code. Only the personal half — settings.local.json is per-developer
# permissions and holds absolute paths from whoever's machine wrote it, so it
# is never shareable. The rest of .claude/ is: settings.json, skills/, agents/
# and commands/ are team config and should be committed when someone adds one
# (.claude/skills/backend-ui-slice is already scaffolded). Same split as
# .vscode/settings.json above — ignore the personal file, not the tool's
# directory, or the shared half can never land.
.claude/settings.local.json


# Local MCP config — contains a registry credential, do not commit
.mcp.json
values.json

# Local-only MCP planning/research docs — not pushed to remote
/mcp_upload_flow_docs/
/docs/MCP_GITHUB_IMPORT_UI_GAP_ANALYSIS.md
/docs/MCP_SERVER_UPLOAD_EE_IMPLEMENTATION_PLAN.md
/docs/MCP_UPLOAD_PLAN_OSS.md
.preview-shots/
/_to_delete/
# The same holder, anywhere. The Cowork device mount cannot unlink, so a file
# that has to go gets moved into one of these instead of deleted; a stray one
# under ui/ was otherwise an untracked directory in every status.
_to_delete/
/_xfer/
# Recorded eval runs (ui/scripts/eval-generations.mjs --record). One directory
# per run, kept so a baseline is never lost again — experiment output, not
# source, and it accumulates. To keep one durably, `git add -f` it or copy it
# out; `--compare` takes any directory of .dsl files.
ui/tests/fixtures/runs/

# Local frontend workspace; integrate pages before deciding what to track.
/prototype/

# Private React/Next migration workspace; do not force-add before release approval.
/react/

# Local git worktrees (superpowers workflow)
.worktrees/

# Cloud credentials are never committed (incident 2026-10-14: a service-account key was committed on 2026-08-19).
# Keys live outside the repository (ee/docs/TENANT_PROVISIONING_RUNBOOK.md §2.1); scripts/security/
# check-committed-credentials.sh enforces it in pre-commit and CI for files these patterns do not name.
nasiko-tenant-provisioner.json
gke-key.json
*-sa-key.json
*.serviceaccount.json

# Sensitive licensing material — never commit (keys live out-of-band)
.licensing-keys/

# Local experimental coding-agent scaffolds (root only) + their build zips.
# The real agents live under oss/agents/; these root dirs are scratch.
/claude-code-agent/
/codex-agent/
/opencode-agent/
/*-agent.zip
