{
  "//": "One tsc program per edition: a core page that links a route this edition lacks fails here.",
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "tsBuildInfoFile": "../../node_modules/.tmp/tsconfig.oss.tsbuildinfo",
    "paths": {
      "@nasiko/app-core/*": [
        "../../shared/app-core/src/*"
      ],
      "@nasiko/app-shell/*": [
        "../../shared/app-shell/src/*"
      ],
      "@nasiko/data-access/*": [
        "../../shared/data-access/src/*"
      ],
      "@nasiko/features/*": [
        "../../shared/features/src/*"
      ],
      "@nasiko/mocks/*": [
        "../../shared/mocks/src/*"
      ],
      "@nasiko/testing/*": [
        "../../shared/testing/src/*"
      ],
      "@nasiko/ui/*": [
        "../../shared/ui/src/*"
      ],
      "@edition/*": [
        "./src/*"
      ]
    }
  },
  "include": [
    "src",
    "../../shared/*/src",
    "../../.storybook/preview.tsx"
  ]
}
