{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignoreDependencies": [
    "@fontsource-variable/hanken-grotesk",
    "@fontsource-variable/jetbrains-mono"
  ],
  "ignore": [
    "design/**"
  ],
  "workspaces": {
    ".": {
      "entry": [
        "scripts/*.ts",
        "*/*/scripts/*.ts",
        "e2e/**/*.ts",
        ".storybook/*.{ts,tsx}",
        "*/*/src/main.tsx",
        "*/*/*/src/main.tsx",
        "*/*/src/edition.ts",
        "*/*/*/src/edition.ts",
        "*/*/src/mocks.ts",
        "*/*/*/src/mocks/index.ts",
        "*/*/*/src/genui/frame/runtime.tsx",
        "*/*/*/src/routes/**/*.tsx",
        "*/*/vite.config.ts",
        "*/*/*/vite.config.ts",
        "vite.shared.ts"
      ],
      "project": [
        "scripts/**/*.ts",
        "*/*/scripts/**/*.ts",
        "e2e/**/*.ts",
        "*/*/src/**/*.{ts,tsx}",
        "*/*/*/src/**/*.{ts,tsx}"
      ],
      "ignore": [
        "**/routeTree.gen.ts"
      ],
      "ignoreDependencies": [
        "@assistant-ui/react",
        "acorn",
        "@tanstack/react-query",
        "lucide-react",
        "motion",
        "react-day-picker",
        "react-hook-form",
        "sonner",
        "zod",
        "zustand",
        "sucrase",
        "tailwindcss"
      ]
    },
    "shared/*": {
      "entry": [
        "src/routes/**/*.tsx",
        "src/**/*.test.{ts,tsx}",
        "src/setup.ts",
        "src/*.globalSetup.ts",
        "src/**/*.stories.tsx",
        "src/budgets/components/Budget*.tsx"
      ],
      "project": [
        "src/**/*.{ts,tsx}"
      ],
      "ignore": [
        "src/primitives/**",
        "src/**/*.gen.ts"
      ]
    }
  },
  "ignoreIssues": {
    "shared/ui/src/charts/**": [
      "duplicates",
      "exports",
      "types"
    ],
    "ee/features/enterprise/src/genui/lang/**": [
      "exports",
      "types"
    ]
  }
}
