# pnpm only (`corepack enable && pnpm install`). With engines.npm in package.json unsatisfiable, npm install and npm ci
# stop here before touching node_modules: npm ignores the pnpm workspace, so it would remove every dependency only
# the workspace packages declare and write a package-lock.json. npm run <script> still works. pnpm ignores this file.
engine-strict=true
